# RevenueCat PUBLIC SDK keys (safe to ship in the app binary; kept out of git).
# Copy this file to `.env` and fill in your real values. See docs/08-monetization.md.
#
# Get these from: RevenueCat dashboard → Project Settings → API Keys → "Public app-specific SDK keys".
#   - Apple key starts with  appl_
#   - Google key starts with goog_
# Do NOT use the RevenueCat *secret* key here.

EXPO_PUBLIC_RC_IOS_KEY=appl_your_ios_public_sdk_key
EXPO_PUBLIC_RC_ANDROID_KEY=goog_your_android_public_sdk_key
